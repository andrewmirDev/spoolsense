-- ==============================================================================
-- SpoolDatabase Schema (v2)
-- ==============================================================================
-- BREAKING CHANGE: v1 databases need to be cleared due to schema update
-- Migration: Added colorName column to spoolEntity
-- ==============================================================================

-- Table filament
CREATE TABLE spoolEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    vendor TEXT NOT NULL,
    material TEXT NOT NULL,
    totalWeightGrams INTEGER NOT NULL,
    remainingWeightGrams INTEGER NOT NULL,
    colorHex TEXT NOT NULL,
    colorName TEXT NOT NULL DEFAULT 'Unknown'
);

-- Table printing history
CREATE TABLE printJobEntity (
    id TEXT NOT NULL PRIMARY KEY,
    fileName TEXT NOT NULL,
    spoolId TEXT NOT NULL,
    weightUsedGrams INTEGER NOT NULL,
    timestamp INTEGER NOT NULL,
    status TEXT NOT NULL
);

-- ==============================================================================
-- QUERIES
-- ==============================================================================

-- --- Spool Queries ---

selectAllSpools:
SELECT *
FROM spoolEntity;

selectSpoolById:
SELECT *
FROM spoolEntity
WHERE id = :id;

insertSpool:
INSERT OR REPLACE INTO spoolEntity (
    id, name, vendor, material, totalWeightGrams, remainingWeightGrams, colorHex, colorName
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateSpoolRemainingWeight:
UPDATE spoolEntity
SET remainingWeightGrams = :newWeight
WHERE id = :id;

deleteSpoolById:
DELETE FROM spoolEntity
WHERE id = :id;

-- --- Print Job Queries ---

selectAllPrintJobs:
SELECT *
FROM printJobEntity
ORDER BY timestamp DESC;

insertPrintJob:
INSERT OR REPLACE INTO printJobEntity (
    id, fileName, spoolId, weightUsedGrams, timestamp, status
) VALUES (?, ?, ?, ?, ?, ?);